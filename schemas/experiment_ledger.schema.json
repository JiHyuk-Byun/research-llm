{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research-os experiment ledger",
  "description": "Managed working-memory and loop-control state for a research session. Orchestration sections (current_phase, phases, decisions) are written only by the Rust orchestrator; content sections (hypotheses, proposals, experiments) are written by the agent via MCP tools.",
  "type": "object",
  "required": ["session_id", "schema_version", "current_phase"],
  "properties": {
    "session_id": { "type": "string" },
    "schema_version": { "type": "string" },
    "current_phase": {
      "type": "string",
      "enum": ["INIT", "DISCUSS", "EXPERIMENT", "POST"]
    },
    "phases": {
      "description": "Per-phase orchestration state. Rust-core only. Keyed by phase name.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "last_signal_hash": { "type": ["string", "null"] },
          "last_decision": {
            "type": ["string", "null"],
            "enum": ["STAY", "ADVANCE", "BRANCH", "STOP", null]
          },
          "last_checkpoint_at": { "type": ["string", "null"] },
          "visits": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "description": "Checkpoint audit log. Rust-core only.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phase", "chosen", "by", "at"],
        "properties": {
          "id": { "type": "string" },
          "phase": { "type": "string" },
          "signal_hash": { "type": "string" },
          "question": { "type": "string" },
          "chosen": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "label": { "type": "string" },
              "action": { "type": "string", "enum": ["STAY", "ADVANCE", "BRANCH", "STOP"] },
              "target_phase": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          },
          "by": { "type": "string", "enum": ["human", "llm"] },
          "reason": { "type": "string" },
          "note": { "type": ["string", "null"] },
          "at": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "hypotheses": {
      "description": "Question points / hypotheses raised in DISCUSS. Agent-written.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "status"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "origin": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "turn_id": { "type": "string" }
            },
            "additionalProperties": true
          },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "string",
            "enum": ["open", "under_test", "supported", "refuted", "inconclusive", "parked"]
          },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "proposals": {
      "description": "Experiment proposals bridging DISCUSS to EXPERIMENT. Agent-written; status advanced by checkpoint result.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hypothesis_id", "status"],
        "properties": {
          "id": { "type": "string" },
          "hypothesis_id": { "type": "string" },
          "rationale": { "type": "string" },
          "rough_design": { "type": ["string", "null"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "string",
            "enum": ["proposed", "accepted", "declined", "superseded"]
          },
          "created_at": { "type": "string" },
          "decided_at": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "experiments": {
      "description": "Experiment units. Agent-written; pointer into sessions/{id}/experiments/{exp_id}/.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hypothesis_id", "status"],
        "properties": {
          "id": { "type": "string" },
          "proposal_id": { "type": "string" },
          "hypothesis_id": { "type": "string" },
          "turn_id": { "type": "string" },
          "record_dir": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["planned", "running", "has_results", "analyzed", "done", "abandoned"]
          },
          "outcome": {
            "type": ["string", "null"],
            "enum": ["supports", "contradicts", "inconclusive", null]
          },
          "post_path": { "type": ["string", "null"] },
          "source_note_path": { "type": ["string", "null"] },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
