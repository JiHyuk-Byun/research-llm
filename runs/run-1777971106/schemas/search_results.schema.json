{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research-os search results",
  "type": "object",
  "required": ["run_id", "source_scope_obeyed", "queries", "results", "coverage_gaps"],
  "properties": {
    "run_id": { "type": "string" },
    "source_scope_obeyed": { "type": "boolean" },
    "queries": { "type": "array", "items": { "type": "string" } },
    "browser_render_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "status", "method", "records_found"],
        "properties": {
          "url": { "type": "string" },
          "status": { "type": "string" },
          "method": { "type": "string" },
          "records_found": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "url_or_path", "source_type", "scope_match_rationale"],
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "authors_or_org": { "type": "array", "items": { "type": "string" } },
          "date": { "type": "string" },
          "url_or_path": { "type": "string" },
          "source_type": { "type": "string" },
          "venue_or_publisher": { "type": "string" },
          "abstract_or_snippet": { "type": "string" },
          "discovery_method": { "type": "string" },
          "official_confirmation_url": { "type": "string" },
          "scope_match_rationale": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "rejected_out_of_scope": { "type": "array" },
    "coverage_gaps": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
