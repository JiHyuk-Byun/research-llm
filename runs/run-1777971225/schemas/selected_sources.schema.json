{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research-os selected sources",
  "type": "object",
  "required": ["run_id", "selected_sources", "coverage_gaps"],
  "properties": {
    "run_id": { "type": "string" },
    "selected_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "url_or_path", "rank", "selection_rationale"],
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "url_or_path": { "type": "string" },
          "pdf_url": { "type": "string" },
          "discovery_method": { "type": "string" },
          "official_confirmation_url": { "type": "string" },
          "rank": { "type": "integer" },
          "selection_rationale": { "type": "string" },
          "expected_use": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "not_selected": { "type": "array" },
    "coverage_gaps": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
